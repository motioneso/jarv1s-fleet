#!/usr/bin/env bash
# Starts the fleet coordinator screen.
#
# Lives in the repo so it travels with a checkout; ~/.local/bin/coordinator is a
# symlink to this file. Resolves its own location rather than assuming a path,
# so a clone anywhere works.
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_path="$(readlink -f "$script_path")"
done
repo_root="$(cd "$(dirname "$script_path")/.." && pwd)"
launcher_dir="$repo_root/launcher"

if [ ! -d "$launcher_dir" ]; then
  echo "coordinator: cannot find the launcher folder at $launcher_dir" >&2
  exit 1
fi

cd "$launcher_dir"

# A fresh clone has no dependencies installed; install them once rather than
# failing with a confusing module error.
if [ ! -d node_modules ]; then
  echo "coordinator: first run, installing dependencies..."
  pnpm install
fi

exec pnpm start "$@"
